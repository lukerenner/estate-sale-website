          <div class="pathway-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12.2 3.5H5.3A1.8 1.8 0 0 0 3.5 5.3v6.9a1.8 1.8 0 0 0 .53 1.27l6.5 6.5a1.8 1.8 0 0 0 2.55 0l6.9-6.9a1.8 1.8 0 0 0 0-2.55l-6.5-6.5a1.8 1.8 0 0 0-1.27-.53Z" stroke-linejoin="round"/><circle cx="8.2" cy="8.2" r="1.4"/></svg>
