            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6.7 4h10.6l3.7 5.4L12 21 2.6 9.4Z" stroke-linejoin="round"/><path d="M2.6 9.4h18.4M9.3 4 6.7 9.4 12 21M14.7 4l2.6 5.4L12 21" stroke-linecap="round" stroke-linejoin="round"/></svg>
