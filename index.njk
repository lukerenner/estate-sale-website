              </div>
              <div class="field">
                <label class="field-label" for="consult-need">I need help with&hellip;</label>
                <select id="consult-need" name="I need help with" required>
                  <option value="" selected disabled>Select One&hellip;</option>
                  <option>An appraisal</option>
                  <option>An estate</option>
                  <option>Consignment</option>
                  <option>Something else</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label class="field-label" for="consult-message">Tell us a little about the estate, object, or collection (optional)</label>
              <textarea id="consult-message" name="message" rows="3"></textarea>
            </div>
            <div class="field">
              <label class="field-label" for="consult-photos">Add photos (optional)</label>
              <div class="field-file">
                <input id="consult-photos" name="attachment" type="file" accept="image/jpeg,image/png,image/webp" multiple>
                <p class="form-note">JPG, PNG, or WEBP. Up to 4MB total (large photos are shrunk automatically).</p>
              </div>
            </div>
            <p class="form-submit-error" role="alert" hidden></p>
            <button class="button button-navy" type="submit">Request a Consultation</button>
          </form>
        </div>
        </div>

        <div class="consultation-aside">
          <div class="consultation-media reveal">
            {% art "index-consult-clock", "(max-width: 980px) 100vw, 512px" %}
          </div>
        </div>
      </div>
    </div>
  </section>

{% endblock %}
