<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Analytics — only loads on the live production hostnames, so
     localhost/dev-server/staging/deploy-preview traffic never pollutes real
     data. Carried over from the outgoing garygermer.com (Ucraft) site, whose
     tags were checked 2026-09-14:
       - G-DSW0DFDTQN: the GA4 property the old site's UA-88561544-1 tag
         forwarded to (Universal Analytics itself stopped processing in 2024).
       - AW-741155892: Google Ads tag, kept so remarketing/conversion data
         doesn't silently stop at launch.
     Not carried over: GTM-T6KGFN5 (gtm.js returns 404 — no published
     container, so it was only ever a failed request) and Hotjar 1287910.
     The gtag() stub is defined everywhere so script.js's event calls are
     always safe; off production it just queues into dataLayer, which is handy
     for checking events on staging without sending anything. -->
<script>
window.dataLayer = window.dataLayer || [];
function gtag() { dataLayer.push(arguments); }
window.ggAnalyticsLive = ["garygermer.com", "www.garygermer.com"].indexOf(window.location.hostname) !== -1;
if (window.ggAnalyticsLive) {
  var gaScript = document.createElement("script");
  gaScript.async = true;
  gaScript.src = "https://www.googletagmanager.com/gtag/js?id=G-DSW0DFDTQN";
  document.head.appendChild(gaScript);
  gtag("js", new Date());
  gtag("config", "G-DSW0DFDTQN");
  gtag("config", "AW-741155892");
}
</script>
<title>{{ metaTitle or title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://www.garygermer.com{{ page.url }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}

<meta property="og:type" content="website">
<meta property="og:site_name" content="Gary Germer & Associates">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:url" content="https://www.garygermer.com{{ page.url }}">
<meta property="og:image" content="https://www.garygermer.com{{ ogImage or "/assets/images/art/home-hero-gilded-salon.jpg" }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle or title }}">
<meta name="twitter:description" content="{{ ogDescription or description }}">
<meta name="twitter:image" content="https://www.garygermer.com{{ ogImage or "/assets/images/art/home-hero-gilded-salon.jpg" }}">

<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/instrument-serif-latin.woff2" crossorigin>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=PT+Sans:ital,wght@0,400;0,700;1,400;1,700&display=swap">
<link rel="stylesheet" href="/styles.css">

{% if turnstile.siteKey %}
{# Cloudflare Turnstile — silent bot scoring on every inquiry form. script.js
   renders the widgets (there are a dozen forms, one of them injected at
   runtime by estate-sale.js), so this only has to load the API and hand it
   the key. The promise exists because api.js is async: it can fire its
   onload before script.js has parsed, so the callback resolves a promise
   script.js awaits instead of calling into it directly. #}
<meta name="turnstile-sitekey" content="{{ turnstile.siteKey }}">
<script>
window.ggTurnstileReady = new Promise(function (resolve) { window.ggTurnstileInit = resolve; });
</script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=ggTurnstileInit" async defer></script>
{% endif %}

{% block head %}{% endblock %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<a class="skip-link" href="#main">Skip to content</a>

{% block prebody %}{% endblock %}

{% include "partials/hello-bar.njk" %}
{% include "partials/header.njk" %}

<main id="main">
{% block content %}{% endblock %}
</main>

{% include "partials/footer.njk" %}

<script src="/script.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
