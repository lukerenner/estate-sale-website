<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://www.garygermer.com{{ page.url }}">

<meta property="og:type" content="website">
<meta property="og:site_name" content="Gary Germer & Associates">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:url" content="https://www.garygermer.com{{ page.url }}">
<meta property="og:image" content="https://www.garygermer.com{{ ogImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle or title }}">
<meta name="twitter:description" content="{{ ogDescription or description }}">
<meta name="twitter:image" content="https://www.garygermer.com{{ ogImage }}">

<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/instrument-serif-latin.woff2" crossorigin>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=PT+Sans:ital,wght@0,400;0,700;1,400;1,700&display=swap">
<link rel="stylesheet" href="/styles.css">

{% block head %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

{% block prebody %}{% endblock %}

{% include "partials/header.njk" %}

<main id="main">
{% block content %}{% endblock %}
</main>

{% include "partials/footer.njk" %}

<script src="/script.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
