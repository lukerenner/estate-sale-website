{% extends "layouts/base.njk" %}

{% block content %}

  {# Runs on the same .post-header / .post-body system as blog posts — a legal
     page is another title-then-prose document, and giving it its own header
     classes is what let it drift from the rest of the site. #}
  <!-- ============================== PAGE TITLE ============================== -->
  <section class="section post-header">
    <div class="container-narrow">
      <p class="eyebrow eyebrow-navy">Gary Germer &amp; Associates<span class="eyebrow-sep">·</span>Updated {{ updated | dateDisplay }}</p>
      <h1 class="post-title">{{ title | titleCase }}</h1>
    </div>
  </section>

  <!-- ============================= PAGE BODY ============================= -->
  <section class="section post-body">
    <div class="container-narrow blog-post-body">
      <div class="blog-post-content">
        {{ content | safe }}
      </div>
    </div>
  </section>

  {% set signupSubject = "Legal page" %}
  {% include "partials/signup-band.njk" %}

{% endblock %}
