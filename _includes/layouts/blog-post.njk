{% extends "layouts/base.njk" %}
{% import "partials/blog-card.njk" as cards %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "image": ["https://www.garygermer.com{{ ogImage }}"],
  "datePublished": "{{ publishDate }}",
  "author": { "@type": "Organization", "name": "Gary Germer & Associates" },
  "publisher": { "@type": "Organization", "name": "Gary Germer & Associates" },
  "mainEntityOfPage": "https://www.garygermer.com{{ page.url }}"
}
</script>
{% endblock %}

{% block content %}

  {#
    Every post type shares one skeleton: .post-header (eyebrow → h1) followed by
    the content column. What varies is only the lead media — a photo, a player,
    or the shop gallery — never the page's geometry. Before this, each type
    carried its own header markup, its own vertical rhythm and its own container
    width, which is how article heroes ended up 1200px wide above 780px body
    copy while video heroes were 780px.
  #}
  {% set isVideo = sourceType == "youtube" or sourceType == "amnw" %}
  {% set isShop = sourceType == "shop" %}

  <!-- ============================== POST HEADER ============================== -->
  <section class="section post-header">
    <div class="container{% if not isShop %}-narrow{% endif %}">
      {# One meta line for every post type, so the header rhythm is identical
         whatever the post is: category and date for editorial/video/sale
         posts. Shop items skip the eyebrow entirely — the price runs atop
         the second column instead (see shop-grid-copy below). #}
      {% if not isShop %}
      <p class="eyebrow eyebrow-navy">
        {{ category | blogFilterLabel(sourceType, title) }}<span class="eyebrow-sep">·</span>{{ publishDate | dateDisplay }}
      </p>
      {% endif %}
      <h1 class="post-title">{{ title | titleCase }}</h1>
    </div>
  </section>

  {% if isShop %}
  <!-- ============================ SHOP ITEM BODY ============================ -->
  <section class="section post-body" data-shop-gallery>
    <div class="container">
      <div class="shop-grid">
        <div class="shop-grid-media">
          <div class="shop-gallery-main">
            <img
              data-shop-gallery-main
              src="{{ heroImage.src }}"
              srcset="{{ heroImage.srcset900 }} 900w, {{ heroImage.srcsetFull }} 1800w"
              sizes="(max-width: 860px) 92vw, 520px"
              width="{{ heroImage.width }}" height="{{ heroImage.height }}"
              alt="{{ heroImage.alt }}"
              fetchpriority="high">
            {% if galleryCount and galleryCount > 1 %}
            <button type="button" class="shop-gallery-btn shop-gallery-prev" data-shop-gallery-prev aria-label="Previous photo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="shop-gallery-btn shop-gallery-next" data-shop-gallery-next aria-label="Next photo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            {% endif %}
          </div>
          {% if galleryCount and galleryCount > 1 %}
          <div class="shop-gallery-thumbs">
            {% for i in range(1, galleryCount + 1) %}
            {% set base = slug + "-" + (i | pad2) %}
            <button
              type="button"
              class="shop-gallery-thumb{% if loop.first %} is-active{% endif %}"
              data-shop-gallery-thumb
              data-full-src="/assets/images/blog/{{ slug }}/{{ base }}-1400.webp"
              data-full-srcset="/assets/images/blog/{{ slug }}/{{ base }}-900.webp 900w, /assets/images/blog/{{ slug }}/{{ base }}-1400.webp 1400w"
              aria-label="Show photo {{ i }} of {{ galleryCount }}">
              <img src="/assets/images/blog/{{ slug }}/{{ base }}-480.webp" alt="" loading="lazy">
            </button>
            {% endfor %}
          </div>
          {% endif %}
        </div>
        <div class="shop-grid-copy blog-post-body">
          <div class="blog-post-content blog-post-content--shop">
            {{ content | safe }}
          </div>
          {# Set from the same `price` field the Shopify sync writes into
             front matter on every run, so it can't drift from the live
             listing. #}
          <p class="post-price">{{ price }}</p>
          <div class="shop-ctas">
            {% if sold %}
            <p class="shop-unavailable">This object is no longer available.</p>
            {% else %}
            <a class="button button-primary" href="{{ shopUrl }}">Shop This Item</a>
            {% endif %}
            <a class="button button-secondary" href="https://shop.garygermer.com/collections/newly-listed">Visit Our Online Store</a>
          </div>
          {% include "partials/blog-share.njk" %}
        </div>
      </div>
    </div>
  </section>

  {% else %}
  <!-- ============================== POST BODY ============================== -->
  <section class="section post-body">
    <div class="container-narrow">
      <div class="post-media">
        {% if isVideo %}
        {#
          No autoplay: Chrome/Safari only allow unmuted autoplay once a domain
          has built up enough media-engagement history (which is why
          youtube.com can do it and a small site never will), and a click on
          the blog card that navigated here doesn't carry a "user gesture"
          across the page load, so an unmuted autoplay would just get
          silently blocked anyway. Instead, a big, hard-to-miss play button
          sits over the poster; clicking it *is* the gesture, so sound is
          guaranteed once the visitor presses it. The YouTube embed needs no
          button of ours — it shows its own centered play button.
        #}
        <div class="blog-video-embed">
          {% if sourceType == "youtube" %}
          <iframe src="https://www.youtube-nocookie.com/embed/{{ source.id }}?playsinline=1" title="{{ title }}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          {% else %}
          <video controls playsinline preload="metadata" poster="{{ heroImage.src }}">
            <source src="{{ source.video }}" type="video/mp4">
          </video>
          <button type="button" class="video-play-fallback" data-video-play aria-label="Play video">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
          </button>
          {% endif %}
        </div>
        {% else %}
        <img
          class="post-hero-image"
          src="{{ heroImage.src }}"
          srcset="{{ heroImage.srcset900 }} 900w, {{ heroImage.srcsetFull }} 1800w"
          sizes="(max-width: 860px) 92vw, 780px"
          width="{{ heroImage.width }}" height="{{ heroImage.height }}"
          alt="{{ heroImage.alt }}"
          fetchpriority="high">
        {% endif %}
      </div>

      <div class="blog-post-body">
        <div class="blog-post-content">
          {{ content | safe }}
        </div>

        {% include "partials/blog-cta.njk" %}
        {% include "partials/blog-share.njk" %}
      </div>
    </div>
  </section>
  {% endif %}

  {% set thisPost = { url: page.url, data: { title: title, category: category, sourceType: sourceType } } %}
  {% set related = thisPost | relatedPosts(collections.blogPosts) %}
  {% if related.length %}
  <!-- ========================== RELATED POSTS ========================== -->
  <section class="section">
    <div class="container">
      <div class="stack-header text-center mx-auto">
        <h2 class="section-heading mx-auto">More to Discover</h2>
      </div>
      <div class="blog-grid">
        {% for post in related %}
        {{ cards.blogCard(post, "(max-width: 560px) 92vw, (max-width: 900px) 46vw, 30vw", false, false) }}
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% set signupSubject = "Blog post page" %}
  {% include "partials/signup-band.njk" %}

{% endblock %}
